# ─────────────────────────────────────────────────────────────
#  Imagen SOLO para verlo funcionar en local (docker-compose.dev.yml).
#  Para producción se usa el `Dockerfile` normal, que compila y
#  deja una imagen mínima sin código fuente.
# ─────────────────────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app
RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000

CMD ["sh", "docker/inicio.sh"]
