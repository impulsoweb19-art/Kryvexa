# ─────────────────────────────────────────────────────────────
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA subas .env a git. NUNCA uses el prefijo NEXT_PUBLIC_
#  para secretos: ese prefijo los expone en el navegador.
# ─────────────────────────────────────────────────────────────

# Base de datos
DATABASE_URL="postgresql://recargas:recargas@localhost:5432/recargas?schema=public"

# Entorno
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Secreto para firmar/hashear tokens de sesión (mínimo 32 caracteres).
# Genera uno con:  openssl rand -base64 48
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-o-mas"

# ── Proveedor: RecargasAmérica ──────────────────────────────
# SOLO backend. Si esta variable falta y PROVIDER_MOCK=false, el
# proveedor se marca como no configurado y no se permiten compras.
RECARGAS_AMERICA_BASE_URL="https://panel.recargasamerica.com/api/v1"
RECARGAS_AMERICA_API_KEY=""
RECARGAS_AMERICA_TIMEOUT_MS="30000"

# Modo simulado: true = no se llama a la API real, se usan datos de ejemplo
# tomados de la documentación oficial. Útil mientras no tengas la API key.
PROVIDER_MOCK="true"

# ── Cron ────────────────────────────────────────────────────
# Se envía como  Authorization: Bearer <CRON_SECRET>  a /api/cron/*
CRON_SECRET="cambia-esto-tambien"

# ── Almacenamiento de comprobantes ──────────────────────────
# "local": disco del servidor (demo y Docker/VPS). "blob": Vercel Blob
# (OBLIGATORIO si despliegas en Vercel — ahí el disco no persiste).
STORAGE_DRIVER="local"
# Ruta ABSOLUTA o relativa al proyecto. Debe estar FUERA de /public.
# Solo se usa cuando STORAGE_DRIVER="local".
RECEIPTS_DIR="./storage/receipts"
MAX_RECEIPT_BYTES="5242880"
# Solo cuando STORAGE_DRIVER="blob". Vercel lo agrega solo a las variables
# de entorno del proyecto en cuanto activas "Blob" en Storage → Create Database.
BLOB_READ_WRITE_TOKEN=""

# ── Correo (código para "¿Olvidaste tu contraseña?") ───────────
# API key de https://resend.com. Si falta, el envío del código falla con un
# mensaje claro, pero el resto de la web sigue funcionando con normalidad.
RESEND_API_KEY=""
# Remitente. El dominio debe estar verificado en Resend.
EMAIL_FROM="Kryvexa <no-reply@kryvexa.com>"

# ── Semilla del administrador inicial (solo se usa en db:seed) ──
SEED_ADMIN_EMAIL="admin@tudominio.com"
SEED_ADMIN_PASSWORD="CambiaEstaClave123!"
SEED_ADMIN_NAME="Administrador"
